#!/bin/sh
# Strip Co-Authored-By lines from commit messages
sed -i.bak '/Co-Authored-By/Id' "$1"
# Remove trailing blank lines left behind
sed -i.bak -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$1"
rm -f "$1.bak"

# Disney remotes only: the header must pass commitlint on the first try.
# bamtech (userservices-infrastructure and friends): header <= 72, body lines <= 100 (Jenkins pr-merge).
# twdcgrid: header <= 100. House rule everywhere: type(scope): IDY-N|NOJIRA lowercase subject, no period.
# Escape hatch for a deliberate exception: GIT_HOOK_SKIP=1 git commit ...
[ -n "$GIT_HOOK_SKIP" ] && exit 0
remote=$(git remote get-url origin 2>/dev/null || true)
case "$remote" in
  *github.bamtech.co*) limit=72 ;;
  *github.twdcgrid.net*) limit=100 ;;
  *) exit 0 ;;
esac
header=$(sed -n '1p' "$1")
case "$header" in
  Merge\ *|Revert\ *|fixup!*|squash!*|"") exit 0 ;;
esac
if [ ${#header} -gt $limit ]; then
  echo "commit-msg: header is ${#header} chars, the limit here is $limit" >&2; exit 1
fi
if ! printf '%s' "$header" | grep -Eq '^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([A-Za-z0-9._/-]+\))?!?: (IDY-[0-9]+|NOJIRA) [a-z0-9`].*[^.]$'; then
  echo "commit-msg: header must read 'type(scope): IDY-N|NOJIRA lowercase subject' with no trailing period:" >&2
  echo "  $header" >&2; exit 1
fi
if [ "$limit" -eq 72 ] && awk 'NR>1 && length($0)>100 && $0 !~ /https?:\/\//{f=1} END{exit !f}' "$1"; then
  echo "commit-msg: a body line is over 100 chars; bamtech's Jenkins commitlint fails the PR on it" >&2; exit 1
fi
exit 0
